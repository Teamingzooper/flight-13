// Flight 13's relay: every player's browser connects here instead of to each other, so any network works.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flight13-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // The relay's address is its workers.dev URL; no public preview URLs for versions.
  "workers_dev": true,
  "preview_urls": false,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
